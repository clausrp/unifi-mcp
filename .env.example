# UniFi MCP Server — environment variables
#
# Local controller (after gateway reset, generate an API key in:
#   UniFi Network → Settings → System → API Keys)
UNIFI_HOST=https://192.168.1.1
UNIFI_API_KEY=your-local-api-key

# Cloud alternative (api.ui.com)
# UNIFI_HOST=https://api.ui.com
# UNIFI_API_KEY=your-cloud-api-key
